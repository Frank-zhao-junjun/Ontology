[project]
requires = ["nodejs-24"]

[dev]
build = ["bash", "-c", "export HOME=${HOME:-/tmp} && bash ./scripts/prepare.sh"]
run = ["bash", "-c", "export HOME=${HOME:-/tmp} && bash ./scripts/dev.sh"]
deps = ["git"]

[deploy]
build = ["bash", "-c", "export HOME=${HOME:-/tmp} && bash ./scripts/build.sh"]
run = ["bash", "-c", "export HOME=${HOME:-/tmp} && bash ./scripts/start.sh"]
deps = ["git"]
