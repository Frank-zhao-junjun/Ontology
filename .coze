[project]
requires = ["nodejs-24"]

[dev]
build = ["bash", "-c", "export HOME=${HOME:-/tmp} && export COZE_WORKSPACE_PATH=${COZE_WORKSPACE_PATH:-$(pwd)} && cd \"$COZE_WORKSPACE_PATH\" && bash ./scripts/prepare.sh"]
run = ["bash", "-c", "export HOME=${HOME:-/tmp} && export COZE_WORKSPACE_PATH=${COZE_WORKSPACE_PATH:-$(pwd)} && cd \"$COZE_WORKSPACE_PATH\" && bash ./scripts/dev.sh"]
deps = ["git"]

[deploy]
build = ["bash", "-c", "export HOME=${HOME:-/tmp} && export COZE_WORKSPACE_PATH=${COZE_WORKSPACE_PATH:-$(pwd)} && cd \"$COZE_WORKSPACE_PATH\" && bash ./scripts/build.sh"]
run = ["bash", "-c", "export HOME=${HOME:-/tmp} && export COZE_WORKSPACE_PATH=${COZE_WORKSPACE_PATH:-$(pwd)} && cd \"$COZE_WORKSPACE_PATH\" && bash ./scripts/start.sh"]
deps = ["git"]
