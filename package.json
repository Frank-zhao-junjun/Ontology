{
  "name": "projects",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "ontology": "./src/cli/index.ts"
  },
  "ontology-cli": {
    "name": "ontology-cli",
    "version": "1.0.0",
    "description": "Ontology Modeling CLI - 命令行本体建模工具",
    "bin": {
      "ontology-cli": "./dist/cli/index.js"
    },
    "keywords": [
      "ontology",
      "cli",
      "modeling",
      "mcp",
      "agent"
    ],
    "files": [
      "dist/cli/**/*"
    ],
    "engines": {
      "node": ">=18.0.0"
    }
  },
  "scripts": {
    "ontology": "tsx src/cli/index.ts",
    "build": "bash ./scripts/build.sh",
    "build:cli": "tsup src/cli/index.ts --format esm --dts --out-dir dist/cli",
    "dev": "bash ./scripts/dev.sh",
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint",
    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit src/lib/**",
    "test:integration": "vitest run tests/integration",
    "test:e2e:smoke": "vitest run tests/e2e -t @smoke",
    "test:phase1": "vitest run tests/unit/module-version.spec.ts tests/unit/module-version-store.spec.ts tests/unit/business-chain-tree.spec.ts tests/unit/business-chain-store.spec.ts tests/unit/business-chain-module-status.spec.ts tests/unit/save-epc.spec.ts tests/unit/save-epc-store.spec.ts tests/unit/validate-save-epc.spec.ts tests/unit/rebuild-usage-index.spec.ts tests/unit/upsert-inline.spec.ts tests/integration/business-chain-tree.spec.tsx tests/integration/business-chain-confirm.spec.tsx tests/e2e/business-chain-tree.e2e.spec.ts",
    "test:phase1.5": "vitest run tests/unit/confirm-flow.spec.ts tests/integration/business-chain-confirm.spec.tsx tests/integration/module-detail-actions.spec.tsx tests/integration/version-history-panel.spec.tsx tests/e2e/module-confirm.e2e.spec.ts",
    "test:phase2": "vitest run tests/unit/element-selector.spec.ts tests/unit/element-library.spec.ts tests/unit/element-library-store.spec.ts tests/unit/scenario-workspace.spec.ts tests/unit/scenario-workspace-store.spec.ts tests/integration/element-selector.spec.tsx tests/integration/element-library.spec.tsx tests/integration/element-coverage-badge.spec.tsx tests/integration/scenario-workspace.spec.tsx tests/integration/epc-steps-editor.spec.tsx tests/integration/epc-validation-panel.spec.tsx tests/integration/epc-derivation-workspace.spec.tsx tests/e2e/epc-element-selector.e2e.spec.ts tests/e2e/element-library.e2e.spec.ts tests/e2e/scenario-workspace.e2e.spec.ts",
    "test:phase3": "vitest run tests/unit/business-epc-linter.spec.ts tests/unit/business-epc-linter-store.spec.ts tests/unit/excel-schema.spec.ts tests/unit/excel-export.spec.ts tests/unit/excel-import.spec.ts tests/unit/ai-draft.spec.ts tests/unit/ai-draft-store.spec.ts tests/unit/generate-module-draft-route.spec.ts tests/integration/warning-center.spec.tsx tests/integration/ai-draft-fill.spec.tsx tests/e2e/warning-center.e2e.spec.ts tests/e2e/excel-import-export.e2e.spec.ts",
    "test:phase4": "vitest run tests/unit/legacy-audit.spec.ts tests/unit/legacy-entrypoints-audit.spec.ts tests/unit/legacy-removal-store.spec.ts tests/unit/legacy-migration.spec.ts tests/unit/business-scenario-migration.spec.ts tests/unit/compile-simplified-chain.spec.ts tests/unit/manifest-manufacturing-golden.spec.ts",
    "test:phase:all": "pnpm run test:phase1 && pnpm run test:phase1.5 && pnpm run test:phase2 && pnpm run test:phase3 && pnpm run test:phase4",
    "ci:check": "pnpm run lint && pnpm run ts-check && pnpm run test:unit && pnpm run test:integration && pnpm run test:e2e:smoke && pnpm run test:phase4",
    "lint:build": "eslint . --quiet",
    "validate": "pnpm run --parallel '/^(ts-check|lint:build)$/'"
  },
  "dependencies": {
    "@ant-design/icons": "^6.2.5",
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "^3.958.0",
